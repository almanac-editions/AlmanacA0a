 "build_class_reason": "every shipped file matches its manifest hash",
 "build_class_rule": "ALMANAC_EDITION_MANIFEST \u00a712.7: a distributable is PUBLISHABLE only with zero DRIFT rows. Any DRIFT means the zip would freeze bytes the tree has not frozen, so the build is a PREVIEW and declares itself one on its own face. The \u00a712.2 cold re-hash at deposit is what turns a preview into a publishable build.",
 "edition": "AlmanacA0a \u2014 the centre of the even hybrid family quantum GL1 (PILOT)",
 "assembled_from_manifest": "2026-08-13",
 "assembled_by": "assemble_almanac.py",
 "counts": {
  "note": "THREE DISTINCT NUMBERS DESCRIBE THIS ARTIFACT, each defined below, so the authoritative one is always explicit.",
  "files_shipped": 99,
  "files_shipped_means": "every file in this almanac EXCEPT the two written last, CHECKSUMS.txt and DIST_MANIFEST.json, which cannot hash themselves. This is the number of lines in CHECKSUMS.txt.",
  "files_on_disk": 101,
  "files_on_disk_means": "files_shipped plus CHECKSUMS.txt and DIST_MANIFEST.json. This is what `find . -type f` reports in the unzipped directory.",
  "provenance_rows": 104,
  "provenance_rows_means": "rows in files[] below. Equals files_shipped: every shipped file carries a provenance row. (Before 2026-08-26 this was 69 against 80 shipped, because the Palomar layer, the front matter and the renderer were copied without being recorded. hypervisorA caught it at re-acceptance.)"
 },
 "file_count": 99,
 "file_count_means": "alias of counts.files_shipped, kept for readers of earlier editions",
 "integrity": {
  "ok": 95,
  "drifted": 0,
  "missing": 0,
  "drifted_paths": [],
  "missing_paths": [],
  "how_to_read_this": "DRIFT means the shipped bytes differ from the hash recorded in the edition manifest. The edition's rows are NOT frozen until deposit, so drift before that point is expected and governed \u2014 but it is recorded here rather than smoothed over, because a manifest hash that no longer matches its file is exactly the kind of green-looking wrong answer this project refuses to ship."
